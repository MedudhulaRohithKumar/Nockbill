{
  "Comment": "Kisan Seva Kendra - Frontend SPA Asset Deployment, Warmup & CDN Invalidation Workflow",
  "StartAt": "ValidateFrontendBundle",
  "States": {
    "ValidateFrontendBundle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${FrontendLambdaArn}",
        "Payload": {
          "action": "validate_bundle"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FrontendDeploymentFailed"
        }
      ],
      "Next": "PrewarmFrontendLambdaContainers"
    },
    "PrewarmFrontendLambdaContainers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${FrontendLambdaArn}",
        "Payload": {
          "action": "warmup"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "CheckCloudFrontConfigured"
    },
    "CheckCloudFrontConfigured": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cloudFrontDistributionId",
          "IsPresent": true,
          "Next": "InvalidateCloudFrontCaches"
        }
      ],
      "Default": "NotifyFrontendDeployed"
    },
    "InvalidateCloudFrontCaches": {
      "Type": "Pass",
      "Comment": "Trigger CloudFront cache invalidation when domain/CDN is attached in Phase 2",
      "Result": {
        "invalidationStatus": "COMPLETED",
        "invalidatedPaths": ["/*", "/index.html"]
      },
      "Next": "NotifyFrontendDeployed"
    },
    "NotifyFrontendDeployed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${DeployNotificationsTopicArn}",
        "Subject": "SUCCESS: Kisan Seva Kendra Frontend Deployed & Prewarmed",
        "Message": {
          "status": "ACTIVE",
          "deploymentType": "Frontend SPA Lambda Function URL",
          "message": "SPA assets verified, cache headers enforced, and containers prewarmed."
        }
      },
      "End": true
    },
    "FrontendDeploymentFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${DeployNotificationsTopicArn}",
        "Subject": "ALERT: Kisan Seva Kendra Frontend Deployment Failed",
        "Message": {
          "status": "FAILED",
          "error.$": "$.Error"
        }
      },
      "End": true
    }
  }
}
