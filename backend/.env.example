# ─── Application ────────────────────────────────────────────────
APP_NAME="Fertilizer Shop Manager"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://fertuser:fertpass@localhost:5432/fertilizer_db

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── OCR ─────────────────────────────────────────────────────────
# Options: tesseract | google_vision | azure_vision | aws_textract
OCR_PROVIDER=tesseract

# Path to tesseract binary (Windows example; Linux usually /usr/bin/tesseract)
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Google Vision (set OCR_PROVIDER=google_vision to use)
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Vision (set OCR_PROVIDER=azure_vision to use)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# AWS Textract (set OCR_PROVIDER=aws_textract to use)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ─── File Upload ─────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
UPLOAD_DIR=uploads

# ─── Shop Defaults ───────────────────────────────────────────────
DEFAULT_SHOP_NAME="My Fertilizer Shop"
DEFAULT_CURRENCY=INR
DEFAULT_GST_RATE=18
INVOICE_PREFIX=INV
