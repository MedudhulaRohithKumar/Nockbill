# Environment and App Config
ENVIRONMENT=production
APP_BASE_URL=https://nockbill.com

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kisan_seva_db

# Amazon SES Configuration
SES_ENABLED=True
SES_SENDER_EMAIL=admin@nockbill.com
SES_REGION=ap-south-1

# Google OAuth 2.0 Client ID (Audience verification)
GOOGLE_CLIENT_ID=
