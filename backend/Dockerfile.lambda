FROM python:3.13.18-slim

# Install system dependencies including Tesseract OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task

# Install Python dependencies + AWS Lambda Runtime Interface Client
COPY requirements.txt .
RUN pip install --no-cache-dir --only-binary :all: awslambdaric==3.0.0 && \
    pip install --no-cache-dir --only-binary :all: -r requirements.txt

# Copy only necessary application files (resolves docker:S6470)
COPY app /var/task/app
COPY seed.py /var/task/seed.py
COPY alembic.ini /var/task/alembic.ini
COPY alembic /var/task/alembic

# Run container as non-root user (resolves docker:S6585) while keeping /var/task readable by Lambda runtime
RUN useradd -m -u 1000 appuser && chmod -R a+rX /var/task
USER appuser

# Note: Lambda runs via awslambdaric (no uvicorn process, hence no Server header / --no-server-header).
ENTRYPOINT ["/usr/local/bin/python", "-m", "awslambdaric"]
CMD ["app.lambda_handler.handler"]
