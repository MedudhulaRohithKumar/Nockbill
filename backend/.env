# ─── Application ────────────────────────────────────────────────
APP_NAME="Fertilizer Shop Manager"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fertilizer_db.sqlite3

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── OCR ─────────────────────────────────────────────────────────
# Options: tesseract | google_vision | azure_vision | aws_textract
OCR_PROVIDER=rapidocr

# Path to tesseract binary (Windows example; Linux usually /usr/bin/tesseract)
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ─── File Upload ─────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
UPLOAD_DIR=uploads

# ─── Shop Defaults ───────────────────────────────────────────────
DEFAULT_SHOP_NAME="My Fertilizer Shop"
DEFAULT_CURRENCY=INR
DEFAULT_GST_RATE=18
INVOICE_PREFIX=INV
